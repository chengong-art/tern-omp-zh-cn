-    /* Tool calls render inside the <omp-tool-view> web component, which draws
+/* Stats-style chassis; transcript and tool colors also support TUI palettes. */
+
+* {
+	margin: 0;
+	padding: 0;
+	box-sizing: border-box;
+}
+
+:root {
+	--line-height: 21px;
+	--font-sans: "Inter", ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
+	--font-mono: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
+	--sidebar-width: 280px;
+	--sidebar-min-width: 240px;
+	--sidebar-max-width: 840px;
+	--sidebar-resizer-width: 6px;
+	--content-max-width: 1100px;
+	--hairline: var(--border);
+	--hairline-soft: color-mix(in srgb, var(--text) 7%, transparent);
+	--hairline-strong: color-mix(in srgb, var(--text) 18%, transparent);
+	--hover-wash: color-mix(in srgb, var(--text) 5%, transparent);
+	--inset-bg: var(--info-bg, color-mix(in srgb, var(--text) 4%, transparent));
+	--ring: color-mix(in srgb, var(--accent) 70%, transparent);
+	--radius-card: 12px;
+	--radius-ctl: 8px;
+	--panel: var(--container-bg);
+	--card: var(--info-bg);
+	--raised: color-mix(in srgb, var(--text) 6%, var(--container-bg));
+	--ink-1: var(--text);
+	--ink-2: var(--muted);
+	--ink-3: var(--dim);
+	--ink-4: var(--dim);
+	--accent-a: var(--mdLink);
+	--accent-b: var(--accent);
+}
+
+html {
+	scrollbar-width: thin;
+	scrollbar-color: color-mix(in srgb, var(--text) 22%, transparent) transparent;
+}
+
+body {
+	font-family: var(--font-sans);
+	font-size: 13px;
+	line-height: var(--line-height);
+	color: var(--text);
+	background: var(--body-bg);
+	-webkit-font-smoothing: antialiased;
+	height: 100dvh;
+	overflow: hidden;
+}
+
+[hidden] {
+	display: none !important;
+}
+button,
+input,
+select {
+	font: inherit;
+}
+button,
+a {
+	touch-action: manipulation;
+}
+pre,
+code,
+kbd {
+	font-family: var(--font-mono);
+}
+button {
+	cursor: pointer;
+}
+.skip-link {
+	position: fixed;
+	top: -100px;
+	z-index: 300;
+	padding: 10px;
+	background: var(--container-bg);
