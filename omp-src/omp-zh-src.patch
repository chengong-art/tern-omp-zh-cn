+	display: flex;
+	flex-direction: column;
+	min-height: 0;
+}
+
+.sidebar-section-heading {
+	display: flex;
+	align-items: center;
+	gap: 8px;
+	padding: 14px 16px 8px;
+	color: var(--dim);
+	font-size: 10px;
+	font-weight: 600;
+	text-transform: uppercase;
+	letter-spacing: 0.09em;
+}
+.sidebar-section-heading > span {
+	font-family: var(--font-mono);
+	color: var(--muted);
