+
+/* Thin themed scrollbars everywhere */
+* {
+	scrollbar-width: thin;
+	scrollbar-color: color-mix(in srgb, var(--text) 22%, transparent) transparent;
+}
+
+::-webkit-scrollbar {
+	width: 8px;
