+.topbar-actions {
+	display: flex;
+	align-items: center;
+	gap: 12px;
+	margin-left: auto;
+}
+.view-switch {
+	display: flex;
+	padding: 3px;
+	border: 1px solid var(--hairline);
+	border-radius: 8px;
+	gap: 2px;
+}
+.view-switch button {
+	border: 0;
+	background: transparent;
+	color: var(--muted);
+	padding: 3px 12px;
+	border-radius: 5px;
+	font-size: 12px;
