+.sidebar-header .sidebar-section-heading {
+	padding: 4px 0 10px;
+}
+#session-list {
+	padding: 0 8px 12px;
+	max-height: 34%;
+	overflow: auto;
+	flex-shrink: 0;
+}
+.session-link {
+	display: flex;
+	gap: 8px;
+	align-items: center;
+	padding: 7px 10px 7px calc(10px + var(--depth) * 12px);
+	margin: 2px 0;
+	color: var(--muted);
+	border-radius: 7px;
+	text-decoration: none;
+	min-width: 0;
